{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fabriq Operador",
  "version": "0.1.0",
  "identifier": "pt.fabriq.operador",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "https://v2.fabriq.pt/operador"
  },
  "app": {
    "windows": [
      {
        "title": "Fabriq — Operador do Laser",
        "url": "https://v2.fabriq.pt/operador",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
