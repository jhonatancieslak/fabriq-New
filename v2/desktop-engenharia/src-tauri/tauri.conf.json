{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fabriq Engenharia",
  "version": "0.1.0",
  "identifier": "pt.fabriq.engenharia",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "https://v2.fabriq.pt"
  },
  "app": {
    "windows": [
      {
        "title": "FABRIQ.pt — Engenharia",
        "url": "https://v2.fabriq.pt",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
