{
  "name": "@fabriq/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "FABRIQ Desktop — editor DXF/DWG, nesting e orçamentos (Windows)",
  "author": "Jhonatan Cieslak <jhonatan.cieslak94@gmail.com>",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "pnpm build:renderer && pnpm build:main",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --publish always",
    "dist:win:local": "pnpm build && electron-builder --win --publish never"
  },
  "dependencies": {
    "dxf-parser": "^1.1.2",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "pt.fabriq.desktop",
    "productName": "FABRIQ",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "jhonatancieslak",
      "repo": "fabriq-New",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FABRIQ"
    }
  }
}
