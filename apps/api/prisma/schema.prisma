generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TenantPlan {
  trial
  starter
  pro
  factory
  enterprise
}

enum UserRole {
  admin
  financial
  requester
  viewer
}

enum MachineType {
  laser_cnc
  cnc_router
  plasma
  waterjet
  bending
  guillotine
  welding
  turning
  milling
  other
}

enum MaterialType {
  steel
  stainless
  aluminum
  copper
  brass
  other
}

enum OrderStatus {
  draft
  pending
  in_progress
  completed
  awaiting_invoice
  invoiced
  cancelled
}

enum StageStatus {
  pending
  in_progress
  paused
  completed
}

enum InvoiceType {
  material_and_labor
  labor_only
}

enum InvoiceStatus {
  pending
  invoiced
  cancelled
}

enum NotificationChannel {
  whatsapp
  email
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum ParamSource {
  fabriq_default
  operator_feedback
  admin_manual
}

enum ParamFeedbackResult {
  worked
  adjusted
  failed
}

enum GasType {
  nitrogen
  oxygen
  air
}

enum ProjectStatus {
  open
  in_progress
  completed
  invoiced
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id           String     @id @default(uuid())
  slug         String     @unique
  name         String
  plan         TenantPlan @default(trial)
  subdomain    String?    @unique
  customDomain String?    @unique @map("custom_domain")
  isActive     Boolean    @default(true) @map("is_active")
  settings     Json       @default("{}")
  trialEndsAt       DateTime?  @map("trial_ends_at")
  planExpiresAt     DateTime?  @map("plan_expires_at")
  stripeCustomerId  String?    @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId     String?    @map("stripe_price_id")
  createdAt         DateTime   @default(now()) @map("created_at")

  users        User[]
  operators    Operator[]
  clients      Client[]
  requesters   Requester[]
  projects     Project[]
  machines     Machine[]
  materials    Material[]
  serviceOrders ServiceOrder[]
  cuttingParams CuttingParam[]
  auditLogs     AuditLog[]
  loginAttempts LoginAttempt[]
  blockedIps    BlockedIp[]

  @@map("tenants")
}

// ─── Users (admin, financial, requester) ─────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         UserRole @default(viewer)
  isActive     Boolean  @default(true) @map("is_active")
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  loginAttempts LoginAttempt[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Operators (PWA access) ───────────────────────────────────────────────────

model Operator {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  name         String
  username     String
  passwordHash String  @map("password_hash")
  phone        String?
  email        String?
  machineId    String? @map("machine_id")
  isActive     Boolean @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  machine       Machine?            @relation(fields: [machineId], references: [id])
  refreshTokens RefreshToken[]
  orderStages   OrderStage[]
  orderPhotos   OrderPhoto[]
  paramFeedbacks CuttingParamFeedback[]

  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("operators")
}

// ─── Clients ─────────────────────────────────────────────────────────────────

model Client {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  taxId     String?  @map("tax_id")
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  projects Project[]
  serviceOrders ServiceOrder[]

  @@index([tenantId])
  @@map("clients")
}

// ─── Requesters ───────────────────────────────────────────────────────────────

model Requester {
  id               String  @id @default(uuid())
  tenantId         String  @map("tenant_id")
  name             String
  email            String?
  phone            String?
  notifyWhatsapp   Boolean @default(true) @map("notify_whatsapp")
  notifyEmail      Boolean @default(true) @map("notify_email")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  serviceOrders ServiceOrder[]

  @@index([tenantId])
  @@map("requesters")
}

// ─── Projects (Obras) ────────────────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  clientId    String        @map("client_id")
  code        String
  name        String
  description String?
  status      ProjectStatus @default(open)
  createdById String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  serviceOrders ServiceOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("projects")
}

// ─── Machines ────────────────────────────────────────────────────────────────

model Machine {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  name      String
  type      MachineType
  model     String?
  serial    String?
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at")

  // Parâmetros de custo para cálculo automático de faturação
  costPerHour          Decimal? @map("cost_per_hour")           // €/hora base
  minBilledMinutes     Int?     @map("min_billed_minutes")      // tempo mínimo cobrado (min)
  costPerMinAfterMin   Decimal? @map("cost_per_min_after_min")  // €/min após o mínimo
  materialCostEnabled  Boolean  @default(false) @map("material_cost_enabled")
  marginPercent        Decimal? @map("margin_percent")          // margem sobre o custo total (%)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  operators   Operator[]
  orderStages OrderStage[]

  @@index([tenantId])
  @@map("machines")
}

// ─── Materials ───────────────────────────────────────────────────────────────

model Material {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  name      String
  type      MaterialType
  isActive  Boolean      @default(true) @map("is_active")
  costPerKg Decimal?     @map("cost_per_kg")
  costPerM2 Decimal?     @map("cost_per_m2")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  orderItems OrderItem[]

  @@index([tenantId])
  @@map("materials")
}

// ─── Service Orders ───────────────────────────────────────────────────────────

model ServiceOrder {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  orderNumber  String      @unique @map("order_number")
  projectId    String      @map("project_id")
  clientId     String      @map("client_id")
  requesterId  String?     @map("requester_id")
  status       OrderStatus @default(draft)
  authCode     String      @unique @map("auth_code")
  accessToken  String      @unique @default(uuid()) @map("access_token")
  notes        String?
  cancelReason String?     @map("cancel_reason")
  createdById  String      @map("created_by")
  completedAt  DateTime?   @map("completed_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  project   Project     @relation(fields: [projectId], references: [id])
  client    Client      @relation(fields: [clientId], references: [id])
  requester Requester?  @relation(fields: [requesterId], references: [id])
  stages    OrderStage[]
  items     OrderItem[]
  invoicing Invoicing?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
  @@map("service_orders")
}

// ─── Order Stages (multi-step) ────────────────────────────────────────────────

model OrderStage {
  id             String      @id @default(uuid())
  tenantId       String      @map("tenant_id")
  serviceOrderId String      @map("service_order_id")
  stageNumber    Int         @map("stage_number")
  type           MachineType
  machineId      String?     @map("machine_id")
  operatorId     String?     @map("operator_id")
  status         StageStatus @default(pending)
  startedAt      DateTime?   @map("started_at")
  pausedAt       DateTime?   @map("paused_at")
  completedAt    DateTime?   @map("completed_at")
  cuttingTime    Int?        @map("cutting_time")
  notes          String?
  operatorSignature String?  @map("operator_signature")
  createdAt      DateTime    @default(now()) @map("created_at")

  serviceOrder ServiceOrder           @relation(fields: [serviceOrderId], references: [id])
  machine      Machine?               @relation(fields: [machineId], references: [id])
  operator     Operator?              @relation(fields: [operatorId], references: [id])
  photos       OrderPhoto[]
  paramFeedbacks CuttingParamFeedback[]

  @@index([tenantId])
  @@index([serviceOrderId])
  @@index([operatorId, status])
  @@map("order_stages")
}

// ─── Order Items (peças) ──────────────────────────────────────────────────────

model OrderItem {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  serviceOrderId String  @map("service_order_id")
  materialId     String  @map("material_id")
  filename       String
  description    String
  widthMm        Decimal? @map("width_mm")
  heightMm       Decimal? @map("height_mm")
  areaM2         Decimal? @map("area_m2")
  thicknessMm    Decimal  @map("thickness_mm")
  quantityPlanned Int     @map("quantity_planned")
  quantityDone   Int?    @map("quantity_done")
  sortOrder      Int      @default(0) @map("sort_order")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  material     Material     @relation(fields: [materialId], references: [id])
  files        OrderFile[]

  @@index([serviceOrderId])
  @@map("order_items")
}

// ─── Order Files (DXF/DWG) ───────────────────────────────────────────────────

model OrderFile {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  orderItemId  String   @map("order_item_id")
  originalName String   @map("original_name")
  storagePath  String   @map("storage_path")
  previewPath  String?  @map("preview_path")
  sizeBytes    Int      @map("size_bytes")
  mimeType     String   @map("mime_type")
  createdAt    DateTime @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("order_files")
}

// ─── Order Photos ─────────────────────────────────────────────────────────────

model OrderPhoto {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  orderStageId  String   @map("order_stage_id")
  storagePath   String   @map("storage_path")
  thumbnailPath String?  @map("thumbnail_path")
  takenById     String   @map("taken_by")
  takenAt       DateTime @default(now()) @map("taken_at")

  orderStage OrderStage @relation(fields: [orderStageId], references: [id])
  takenBy    Operator   @relation(fields: [takenById], references: [id])

  @@map("order_photos")
}

// ─── Cutting Params (IA) ──────────────────────────────────────────────────────

model CuttingParam {
  id             String       @id @default(uuid())
  tenantId       String?      @map("tenant_id")
  materialType   MaterialType @map("material_type")
  thicknessMm    Decimal      @map("thickness_mm")
  machineType    MachineType  @map("machine_type")
  speedMmMin     Int          @map("speed_mm_min")
  powerPercent   Decimal      @map("power_percent")
  gasPressureBar Decimal      @map("gas_pressure_bar")
  gasType        GasType      @map("gas_type")
  nozzleMm       Decimal      @map("nozzle_mm")
  frequency      Int?
  notes          String?
  source         ParamSource  @default(fabriq_default)
  confidence     Decimal      @default(1.0)
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant    Tenant?                @relation(fields: [tenantId], references: [id])
  feedbacks CuttingParamFeedback[]

  @@index([materialType, thicknessMm, machineType])
  @@map("cutting_params")
}

// ─── Cutting Param Feedback ───────────────────────────────────────────────────

model CuttingParamFeedback {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")
  paramId        String              @map("param_id")
  operatorId     String              @map("operator_id")
  orderStageId   String              @map("order_stage_id")
  result         ParamFeedbackResult
  actualSpeed    Int?                @map("actual_speed")
  actualPower    Decimal?            @map("actual_power")
  actualPressure Decimal?            @map("actual_pressure")
  notes          String?
  createdAt      DateTime            @default(now()) @map("created_at")

  param      CuttingParam @relation(fields: [paramId], references: [id])
  operator   Operator     @relation(fields: [operatorId], references: [id])
  orderStage OrderStage   @relation(fields: [orderStageId], references: [id])

  @@map("cutting_param_feedbacks")
}

// ─── Invoicing ────────────────────────────────────────────────────────────────

model Invoicing {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  serviceOrderId String        @unique @map("service_order_id")
  type           InvoiceType
  costValue      Decimal?      @map("cost_value")
  invoiceDate    DateTime?     @map("invoice_date")
  invoicedById   String?       @map("invoiced_by")
  status         InvoiceStatus @default(pending)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id])

  @@map("invoicing")
}

// ─── Refresh Tokens ───────────────────────────────────────────────────────────

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  operatorId String?   @map("operator_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id])
  operator Operator? @relation(fields: [operatorId], references: [id])

  @@map("refresh_tokens")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  operatorId String?  @map("operator_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([action])
  @@map("audit_logs")
}

// ─── Login Attempts (auditoria de acessos) ────────────────────────────────────

model LoginAttempt {
  id            String   @id @default(uuid())
  tenantId      String?  @map("tenant_id")
  userId        String?  @map("user_id")
  email         String
  success       Boolean
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([ipAddress])
  @@index([email])
  @@index([tenantId])
  @@index([createdAt])
  @@map("login_attempts")
}

// ─── Blocked IPs ──────────────────────────────────────────────────────────────

model BlockedIp {
  id          String    @id @default(uuid())
  ipAddress   String    @unique @map("ip_address")
  reason      String?
  blockedBy   String?   @map("blocked_by")
  isAutoBlock Boolean   @default(false) @map("is_auto_block")
  tenantId    String?   @map("tenant_id")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([ipAddress])
  @@index([tenantId])
  @@map("blocked_ips")
}

// ─── Notification Log ─────────────────────────────────────────────────────────

model NotificationLog {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  channel          NotificationChannel
  recipientPhone   String?             @map("recipient_phone")
  recipientEmail   String?             @map("recipient_email")
  template         String
  status           NotificationStatus  @default(pending)
  errorMessage     String?             @map("error_message")
  sentAt           DateTime?           @map("sent_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("notification_logs")
}
