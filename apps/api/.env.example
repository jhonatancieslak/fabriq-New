# Database
DATABASE_URL=postgresql://fabriq:password@127.0.0.1:5432/fabriq_db

# Redis
REDIS_URL=redis://127.0.0.1:6379/2

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Server
NODE_ENV=development
PORT=8190
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3190

# Storage (MinIO / S3)
S3_ENDPOINT=http://127.0.0.1:9190
S3_BUCKET=fabriq
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Encryption (AES-256-GCM — 32 bytes hex)
ENCRYPTION_KEY=change-me-32-bytes-hex-encryption-key-here

# App
APP_URL=http://localhost:3190
